{
  "name": "teleprompter-android",
  "version": "1.0.0",
  "private": true,
  "description": "Teleprompter para Android (Capacitor), compatível com os roteiros do Teleprompter Multi Laudas",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
